{
  "version": 2,
  "github": {
    "silent": true
  },
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    },
    {
      "src": "oauth.js",
      "use": "@vercel/node"
    },
    {
      "src": "oauth/index.json",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/oauth/?",
      "dest": "/oauth/index.json",
      "headers": {
        "Cache-Control": "public, max-age=300"
      }
    },
    {
      "src": "/oauth/google/?",
      "dest": "/oauth.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.js",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow",
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin"
      }
    }
  ],
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- ."
}
