---
import "katex/dist/katex.min.css";
import "@fontsource-variable/inter/wght.css";
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Seo from "../components/Seo.astro";
import GoogleTag from '../components/GoogleTag.astro';
import Advertisement from '../components/Advertisement.astro';
import TechnologyCards from '../components/TechnologyCards.astro';
import MidPageContent from '../components/MidPageContent.astro';
import '../styles/advertising.css';
import '../styles/business.css';
import EnvironmentPreference from '../components/EnvironmentPreference.astro';
import BusinessSidebar from '../components/BusinessSidebar.astro';
import { ambienteDaRota } from '../lib/ambientes';

interface Props { titulo?: string; descricao?: string; home?: boolean; noindex?: boolean }
const { titulo, descricao, home = false, noindex = false } = Astro.props;
const ambiente = ambienteDaRota(Astro.url.pathname);
const business = ambiente === 'business';
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <GoogleTag />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <Seo titulo={titulo} descricao={descricao} noindex={noindex} />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    {home && <link rel="preload" as="image" href={'/img/harpya-original.webp'} />}
  </head>
  <body class:list={[home ? "is-home" : "is-internal", { 'is-business': business }]} data-environment={ambiente}>
    <a class="skip" href="#conteudo">Pular para o conteúdo</a>
    <Header />
    <div class="ad-layout">
    <main id="conteudo">
      <MidPageContent ambiente={ambiente}><slot /></MidPageContent>
    </main>
    <aside class="ad-rail ad-rail-right" aria-label={business ? 'Publicidade e fontes de negócios' : 'Publicidade e leituras de tecnologia'}>
      <Advertisement posicao="lateral-direita" ambiente={ambiente} />
      {business ? <BusinessSidebar /> : <TechnologyCards />}
      <Advertisement posicao="lateral-esquerda" ambiente={ambiente} />
    </aside>
    </div>
    <Footer />
    {!noindex && <EnvironmentPreference />}
    <script>
      import "../scripts/site.ts";
    </script>
  </body>
</html>
