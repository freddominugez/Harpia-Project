---
// Layout da seção "Começando": a marca do Harpya no alto e o artigo com o estilo próprio
// da série (tipografia serifada, figuras em SVG, tema claro e escuro), como o autor entregou.
import "@fontsource-variable/source-serif-4/opsz.css";
import "@fontsource-variable/source-serif-4/opsz-italic.css";
import "@fontsource-variable/inter/wght.css";
import serifLatin from "@fontsource-variable/source-serif-4/files/source-serif-4-latin-opsz-normal.woff2?url";
import "../artigos/comecando/serie.css";
import Seo from "../components/Seo.astro";
import { SITE } from "../config";
import Advertisement from '../components/Advertisement.astro';
import VisitCounter from '../components/VisitCounter.astro';
import '../styles/advertising.css';

interface Props { titulo: string; descricao: string }
const { titulo, descricao } = Astro.props;
const ano = new Date().getFullYear();
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <Seo titulo={titulo} descricao={descricao} />
    <link rel="preload" href={serifLatin} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="cm-skip" href="#conteudo">Pular para o conteúdo</a>
    <header class="cm-top">
      <div class="cm-top-in">
        <a class="cm-brand" href="/" aria-label={`${SITE.nome}, página inicial`}>
          <img src="/img/harpya-mark-head.webp" alt="" width="40" height="37" />
          <b>HARPYA</b>
        </a>
        <span class="cm-sep" aria-hidden="true"></span>
        <a class="cm-secao" href="/comecando/">Começando</a>
        <a class="cm-site" href="/">Voltar ao site →</a>
      </div>
    </header>
    <Advertisement posicao="topo" />
    <div class="ad-layout">
    <aside class="ad-rail ad-rail-left"><Advertisement posicao="lateral-esquerda" /></aside>
    <main id="conteudo">
      <slot />
    </main>
    <aside class="ad-rail ad-rail-right"><Advertisement posicao="lateral-direita" /></aside>
    </div>
    <footer class="cm-foot">
      <div class="cm-foot-in">
        <VisitCounter />
        <span><b>{SITE.assinatura}</b></span>
        <span>© {ano} {SITE.nome}. Todos os direitos reservados, ressalvadas as licenças CC BY 4.0 e MIT.</span>
        <nav class="cm-foot-links" aria-label="Links do rodapé">
          <a href="/termos-de-uso/">Termos de Uso</a>
          <a href="/biblioteca/fontes/">Fontes do site</a>
          <a href="/">harpya.org</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
