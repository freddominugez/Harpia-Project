---
import Base from "../../layouts/Base.astro";
import PageIntro from "../../components/PageIntro.astro";
import SourceGroups from "../../components/SourceGroups.astro";
import fontes from "../../data/fontes.json";
const nFontes = fontes.reduce((s, g) => s + g.itens.length, 0);
---
<Base titulo="Fontes" descricao={`${nFontes} fontes de alta qualidade: institutos de matemática e física, grandes projetos, repositórios de artigos e laboratórios de IA.`}>
  <PageIntro trilha={[{ rotulo: "Biblioteca", href: "/biblioteca/" }, { rotulo: "Fontes" }]} eyebrow="Biblioteca" titulo={`${nFontes} fontes de alta qualidade`} lead="Institutos de matemática e física no Brasil e no exterior, grandes projetos, repositórios de artigos, laboratórios de IA dos Estados Unidos e da China, e o código aberto que roda tudo." />
  <section class="page-body"><div class="container"><SourceGroups /></div></section>
</Base>
