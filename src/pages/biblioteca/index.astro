---
import Base from "../../layouts/Base.astro";
import PageIntro from "../../components/PageIntro.astro";
import Tag from "../../components/Tag.astro";
import { LIVROS as livros, ARTIGOS as artigos, FONTES_POR_GRUPO as fontes } from "../../lib/conteudo";
const nFontes = fontes.reduce((s, g) => s + g.itens.length, 0);
const ordenados = [...artigos].sort((a, b) => a.ano - b.ano);
---
<Base titulo="Biblioteca" descricao="Livros, artigos acadêmicos e fontes de alta qualidade sobre matemática, física e IA.">
  <PageIntro trilha={[{ rotulo: "Biblioteca" }]} eyebrow="Biblioteca" titulo="Livros, artigos e onde pesquisar" lead="Cada item indica o caminho do projeto que ele sustenta. Vários livros têm edição gratuita oficial.">
    <div class="tag-row">
      <Tag href="#livros">{livros.length} livros</Tag><Tag href="#artigos">{artigos.length} artigos</Tag><Tag href="/biblioteca/fontes/">{nFontes} fontes</Tag><Tag href="/biblioteca/glossario/">Glossário</Tag>
    </div>
  </PageIntro>

  <section class="section" id="livros">
    <div class="container">
      <div class="section-head"><div><h2>Livros</h2><p>Da álgebra linear aos reticulados.</p></div></div>
      <div class="shelf">
        {livros.map((l) => (
          <div class="book">
            {l.url ? (
              <a class={`cover ${l.cor}`} href={l.url} target="_blank" rel="noopener noreferrer"><small>{l.nota.toUpperCase()}</small><b>{l.titulo}</b><small>{l.autores}</small></a>
            ) : (
              <div class={`cover ${l.cor}`}><small>{l.nota.toUpperCase()}</small><b>{l.titulo}</b><small>{l.autores}</small></div>
            )}
            <div class="info"><strong>{l.uso.split(":")[0]}</strong>{l.uso.includes(":") ? ` · ${l.uso.split(":")[1].trim()}` : ""}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="artigos">
    <div class="container">
      <div class="section-head"><div><h2>Artigos acadêmicos</h2><p>Os trabalhos que definem a base a bater e a arte prévia de cada caminho.</p></div></div>
      <div class="filters" role="group" aria-label="Filtrar artigos">
        <button type="button" data-grupo="todos" aria-pressed="true">Todos</button>
        <button type="button" data-grupo="fund" aria-pressed="false">Fundamentos</button>
        <button type="button" data-grupo="busca" aria-pressed="false">Busca e quantização</button>
        <button type="button" data-grupo="arte" aria-pressed="false">Arte prévia</button>
      </div>
      <div class="papers">
        {ordenados.map((p) => (
          <div class="paper" data-grupo={p.grupo}>
            <div class="ano">{p.ano}</div>
            <div><a href={p.url} target="_blank" rel="noopener noreferrer">{p.titulo}</a><div class="v">{p.autores}</div></div>
            <span class={`tag ${p.selo}`}>{p.rotulo}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="fontes">
    <div class="container">
      <div class="panel teaser">
        <div><h2 style="margin-bottom:4px">{nFontes} fontes de alta qualidade</h2><p>Institutos de matemática e física, grandes projetos, repositórios de artigos, laboratórios de IA dos Estados Unidos e da China, e o código aberto que roda tudo.</p></div>
        <a class="btn gold slim" href="/biblioteca/fontes/">Ver as fontes →</a>
      </div>
    </div>
  </section>
</Base>
<script>
  document.querySelectorAll<HTMLButtonElement>(".filters button[data-grupo]").forEach((b, _, todos) => {
    b.addEventListener("click", () => {
      todos.forEach((x) => x.setAttribute("aria-pressed", "false"));
      b.setAttribute("aria-pressed", "true");
      const g = b.dataset.grupo;
      document.querySelectorAll<HTMLElement>(".paper[data-grupo]").forEach((p) => { p.hidden = !(g === "todos" || p.dataset.grupo === g); });
    });
  });
</script>
