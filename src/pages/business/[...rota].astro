---
import {render,type CollectionEntry} from 'astro:content';
import Base from '../../layouts/Base.astro';
import EditorialHome from '../../components/EditorialHome.astro';
import BusinessSection from '../../components/BusinessSection.astro';
import StudyArticle from '../../components/StudyArticle.astro';
import AnalysisArticle from '../../components/AnalysisArticle.astro';
import NoticiasPagina from '../../components/NoticiasPagina.astro';
import BusinessResourceDetail from '../../components/BusinessResourceDetail.astro';
import {getBusiness,SECOES_BUSINESS,guiaPath,recursoPublicadoPath} from '../../lib/business';
import {getBusinessPresentation} from '../../lib/business-presentation';
export async function getStaticPaths(){
 const {guias,acervo,analises}=await getBusiness();
 return [
  ...SECOES_BUSINESS.filter(s=>s.slug!=='comecando').map(s=>({params:{rota:s.slug||undefined},props:{tipo:'secao',secao:s.slug}})),
  {params:{rota:'metricas'},props:{tipo:'secao',secao:'equacoes'}},
  ...['estudos/a-ideia-mais-interessante','estudos/arquivados'].map(secao=>({params:{rota:secao},props:{tipo:'secao',secao}})),
  ...guias.flatMap(guia=>[guiaPath(guia.id),`/business/estudos/${guia.id}/`].map(path=>({params:{rota:path.replace(/^\/business\/|\/$/g,'')},props:{tipo:'guia',guia}}))),
  ...analises.map(analise=>({params:{rota:`analises/${analise.id}`},props:{tipo:'analise',analise}})),
  ...acervo.map(item=>({params:{rota:recursoPublicadoPath(item.id,item.data.tipo).replace(/^\/business\/|\/$/g,'')},props:{tipo:'recurso',item}})),
 ];
}
interface Props {tipo:'secao'|'guia'|'analise'|'recurso';secao?:string;guia?:CollectionEntry<'businessGuias'>;analise?:CollectionEntry<'businessAnalises'>;item?:CollectionEntry<'businessAcervo'>}
const {tipo,secao='',guia,analise,item}=Astro.props;
const {guias,fontes}=await getBusiness();
const page=SECOES_BUSINESS.find(s=>s.slug===secao);
const especiais:Record<string,{titulo:string;descricao:string}>={
 'estudos/arquivados':{titulo:'Arquivados',descricao:'Propostas de medição avaliadas conceitualmente, com motivos e condições para reconsideração.'},
 'estudos/a-ideia-mais-interessante':{titulo:'Quem compraria mesmo sem o anúncio?',descricao:'Uma investigação didática da comparação necessária para estimar efeito incremental.'},
};
const titulo=guia?.data.titulo??analise?.data.titulo??item?.data.titulo??page?.titulo??especiais[secao]?.titulo;
const descricao=guia?.data.resumo??analise?.data.resumo??item?.data.resumo??page?.descricao??especiais[secao]?.descricao;
const leitura=guia?await render(guia):analise?await render(analise):null;
const Content=leitura?.Content;
const nomeReferencia=(body:string|undefined,url:string)=>[...(body??'').matchAll(/\[([^\]]+)\]\((https:\/\/[^\s)]+)\)/g)].find(m=>m[2]===url)?.[1]??new URL(url).hostname;
const fichas=guias.map(g=>({id:g.id,href:guiaPath(g.id),markdown:`${guiaPath(g.id).replace(/\/$/,'')}.md`,body:g.body,data:{...g.data,autor:'Harpya',rotulo:'Guia',estatuto:'teste' as const,selo:'Guia didático',principal:false,arte_previa:g.data.fontes.map(url=>({texto:nomeReferencia(g.body,url),url})),referencias_descricao:'Fontes indicadas neste guia. Verifique contexto e limites na publicação original.'}}));
const indice=guia?guias.findIndex(g=>g.id===guia.id):-1;
const m=item?.data.tipo==='noticia'?await getBusinessPresentation():null;
---
{tipo==='secao'&&secao===''?<EditorialHome business />:
 <Base titulo={titulo} descricao={descricao}>
  {tipo==='secao'&&<BusinessSection secao={secao}/>}
  {tipo==='guia'&&leitura&&<StudyArticle c={fichas[indice]} todos={fichas} ant={fichas[indice-1]??null} prox={fichas[indice+1]??null} Content={leitura.Content} headings={leitura.headings} prefixo="/business"/>}
  {tipo==='analise'&&analise&&leitura&&Content&&<AnalysisArticle d={analise.data} minutos={Math.max(1,Math.round((analise.body??'').split(/\s+/).length/200))} toc={leitura.headings.filter(h=>h.depth===2).map(h=>({id:h.slug,texto:h.text}))} relacionados={[]} autor={analise.data.autor} prefixo="/business"><Content/></AnalysisArticle>}
  {tipo==='recurso'&&item&&(m?<NoticiasPagina atual={m.noticias.find(n=>n.slug===item.id)!} noticias={m.noticias} tituloNoH1 negocios prefixo="/business" lead="Marketing e administração com fontes, contexto e limites da evidência." periodicidade="após revisão editorial"/>:<BusinessResourceDetail item={item} fonte={fontes.find(f=>f.id===item.data.fonte)}/>)}
 </Base>}
