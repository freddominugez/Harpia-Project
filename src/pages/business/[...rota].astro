---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import BusinessResourceDetail from '../../components/BusinessResourceDetail.astro';
import BusinessPage from '../../components/BusinessPage.astro';
import { getBusiness, SECOES_BUSINESS, guiaPath, trilhaNome } from '../../lib/business';
export async function getStaticPaths() {
  const { guias, acervo } = await getBusiness();
  return [
    ...SECOES_BUSINESS.map(page => ({ params: { rota: page.slug || undefined }, props: { tipo: 'secao' as const, secao: page.slug } })),
    ...guias.map(guia => ({ params: { rota: `estudos/${guia.id}` }, props: { tipo: 'guia' as const, guia } })),
    ...acervo.map(item => ({ params: { rota: `leituras/${item.id}` }, props: { tipo: 'recurso' as const, item } })),
  ];
}
interface Props { tipo: 'secao' | 'guia' | 'recurso'; secao?: string; guia?: CollectionEntry<'businessGuias'>; item?: CollectionEntry<'businessAcervo'> }
const { tipo, secao = '', guia, item } = Astro.props;
const page = SECOES_BUSINESS.find(p => p.slug === secao);
const titulo = tipo === 'guia' ? guia!.data.titulo : tipo === 'recurso' ? item!.data.titulo : page!.titulo;
const descricao = tipo === 'guia' ? guia!.data.resumo : tipo === 'recurso' ? item!.data.resumo : page!.descricao;
const rendered = guia ? await render(guia) : null;
const Content = rendered?.Content;
const { guias, fontes } = await getBusiness();
const fonte = item ? fontes.find(f => f.id === item.data.fonte) : undefined;
const indice = guia ? guias.findIndex(g => g.id === guia.id) : -1;
---
<Base titulo={titulo} descricao={descricao} home={tipo === 'secao' && secao === ''}>
  {tipo === 'secao' && <BusinessPage secao={secao} />}
  {tipo === 'guia' && guia && <>
    <header class="container business-page-intro"><nav aria-label="Caminho da página"><a href="/business/">Harpya Business</a> / <a href="/business/estudos/">Estudos</a> / Guia {guia.data.numero}</nav><span class="eyebrow">{trilhaNome(guia.data.trilha)}</span><h1 tabindex="-1">{guia.data.titulo}</h1><p>{guia.data.resumo}</p></header>
    <div class="container business-section business-guide"><div class="business-guide-layout"><article class="article">{Content && <Content />}<div class="business-reference-list"><strong>Referências para aprofundamento</strong>{guia.data.fontes.map(url => <a href={url} target="_blank" rel="noopener noreferrer">{url} ↗</a>)}<p style="margin-top:12px">Guia didático do Harpya · Atualizado em {guia.data.atualizado}. Os links levam aos originais; idioma e disponibilidade podem variar.</p></div><nav class="business-pagination" aria-label="Sequência de estudo">{indice > 0 ? <a href={guiaPath(guias[indice-1].id)}>← Guia anterior</a> : <a href="/business/comecando/">← Ver a sequência</a>}{indice < guias.length-1 && <a href={guiaPath(guias[indice+1].id)}>Próximo guia →</a>}</nav><div class="business-policy"><h2>Continue a investigação</h2><p>Consulte leituras relacionadas, compare contextos e leve uma pergunta fundamentada à comunidade.</p><a href={`/business/biblioteca/?trilha=${guia.data.trilha}`}>Leituras desta trilha →</a> · <a href="/business/forum/">Discutir na comunidade →</a></div></article><nav class="business-guide-toc toc" aria-label="Neste guia"><strong>Neste guia</strong>{rendered?.headings.map(h => <a href={`#${h.slug}`}>{h.text}</a>)}</nav></div></div>
  </>}
  {tipo === 'recurso' && item && <>
    <header class="container business-page-intro"><nav aria-label="Caminho da página"><a href="/business/">Harpya Business</a> / <a href="/business/biblioteca/">Biblioteca</a></nav><span class="eyebrow">{item.data.evidencia}</span><h1 tabindex="-1">{item.data.titulo}</h1><p>{item.data.resumo}</p></header>
    <BusinessResourceDetail item={item} fonte={fonte} />
  </>}
</Base>
