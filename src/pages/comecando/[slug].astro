---
// Um artigo da série, publicado como o autor entregou, dentro da moldura "Começando".
import Comecando from "../../layouts/Comecando.astro";
import { COMECANDO, corpoDe } from "../../data/comecando";
import BeginnerNavigation from "../../components/BeginnerNavigation.astro";

export function getStaticPaths() {
  return COMECANDO.map((a, i) => ({ params: { slug: a.slug }, props: { a, ant: COMECANDO[i - 1] ?? null, prox: COMECANDO[i + 1] ?? null } }));
}
const { a, ant, prox } = Astro.props;
---
<Comecando titulo={a.titulo} descricao={a.descricao}>
  <Fragment set:html={corpoDe(a.slug)} />
  <BeginnerNavigation a={a} ant={ant} prox={prox} />
</Comecando>
