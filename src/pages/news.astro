---
import Base from "../layouts/Base.astro";
import PageIntro from "../components/PageIntro.astro";
import NewsCard from "../components/NewsCard.astro";
---
<Base titulo="News" descricao="Manchetes de laboratórios de IA e do arXiv ligadas a embeddings, busca vetorial e eficiência.">
  <PageIntro trilha={[{ rotulo: "News" }]} eyebrow="News" titulo="O que saiu sobre eficiência" lead="Coletado de feeds RSS de laboratórios de IA, do arXiv e de divulgação científica, filtrado pelos termos do projeto. As datas são do anúncio ou atualização no feed e podem diferir da primeira submissão; as manchetes não equivalem a resultados reproduzidos pelo Harpya." />
  <section class="page-body"><div class="container"><NewsCard limite={40} /></div></section>
</Base>
