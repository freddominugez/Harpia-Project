---
import Base from '../layouts/Base.astro';
import VideoCatalog from '../components/VideoCatalog.astro';
import { VIDEOS, MODULOS } from '../lib/videos';
const porModulo = MODULOS.filter(m => VIDEOS.some(v => v.modulo === m.numero));
---
<Base titulo="Vídeos" descricao={`Catálogo de ${VIDEOS.length} vídeos sobre LLMs, do token ao raciocínio, organizado em ${porModulo.length} módulos e três níveis, com resumo em português.`}>
  <VideoCatalog />
</Base>
