---
import Base from '../../../layouts/Base.astro';
import StudyArticle from '../../../components/StudyArticle.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const caminhos = (await getCollection("caminhos")).sort((a, b) => a.data.numero - b.data.numero);
  return caminhos.map((c, i) => ({
    params: { slug: c.id },
    props: { c, todos: caminhos, ant: caminhos[i - 1] ?? null, prox: caminhos[i + 1] ?? null },
  }));
}
const { c, todos, ant, prox } = Astro.props;
const d = c.data;
const { Content, headings } = await render(c);
---
<Base titulo={d.titulo} descricao={d.resumo}>
  <StudyArticle c={c} todos={todos} ant={ant} prox={prox} Content={Content} headings={headings} />
</Base>
