---
import Base from "../layouts/Base.astro";
---
<Base titulo="Página não encontrada">
  <section class="container not-found">
    <picture>
      <source srcset="/img/harpya-mark-head.webp" type="image/webp" />
      <img src="/img/harpya-mark-head.png" alt="" width="150" height="140" />
    </picture>
    <div class="eyebrow">Erro 404</div>
    <h1 style="margin-top:12px">Esta trilha não existe</h1>
    <p>A página pode ter mudado de lugar. Use a busca ou volte para o início.</p>
    <div class="ref-hero-cta" style="justify-content:center">
      <a class="btn gold" href="/">Voltar ao início</a>
      <button type="button" class="btn outline" data-search-open>Pesquisar no site</button>
    </div>
  </section>
</Base>
