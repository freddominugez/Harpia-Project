---
// Página inicial: reprodução da composição aprovada (docs/referencia-home-exata.png).
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Kpi from "../components/Kpi.astro";
import StudyTrackCard from "../components/StudyTrackCard.astro";
import ArticleCard from "../components/ArticleCard.astro";
import VideoFeature from "../components/VideoFeature.astro";
import ForumList from "../components/ForumList.astro";
import JoinCommunityCard from "../components/JoinCommunityCard.astro";
import { getCollection } from "astro:content";
import videos from "../data/videos.json";
import { kpis, trilhas, ARTIGOS_DESTAQUE, VIDEO_DESTAQUE, TOPICOS_PROPOSTOS } from "../data/home";
import { dataCurta, ROTULO_ESTATUTO } from "../lib/format";

const caminhos = await getCollection("caminhos");
const porSlug = new Map(caminhos.map((c) => [c.id, c]));
const artigos = ARTIGOS_DESTAQUE.flatMap((a) => {
  const c = porSlug.get(a.slug);
  return c ? [{ ...a, c }] : [];
});
const video = videos.find((v) => v.id === VIDEO_DESTAQUE.id) ?? videos[0];
---
<Base home>
  <Hero />

  <section class="ref-stat-section" aria-label="O acervo em números">
    <div class="container ref-stats">
      {kpis(caminhos.length).map((k) => <Kpi k={k} />)}
    </div>
  </section>

  <section class="ref-content">
    <div class="container wide ref-columns">
      <div class="ref-column ref-left">
        <section class="ref-section" aria-labelledby="h-trilhas">
          <div class="ref-section-title">
            <div><h2 id="h-trilhas">Trilhas de Estudo em Destaque</h2><p>Percursos estruturados para evoluir do básico ao avançado.</p></div>
            <a href="/estudos/">Ver todas <span aria-hidden="true">→</span></a>
          </div>
          <div class="ref-track-grid">
            {trilhas(caminhos.length).map((t) => <StudyTrackCard t={t} />)}
          </div>
        </section>
        <section class="ref-section" aria-labelledby="h-artigos">
          <div class="ref-section-title">
            <div><h2 id="h-artigos">Artigos Recentes</h2></div>
            <a href="/estudos/">Ver todos os estudos <span aria-hidden="true">→</span></a>
          </div>
          <div class="ref-articles">
            {artigos.map(({ c, imagem, tags }) => (
              <ArticleCard
                href={`/estudos/caminhos/${c.id}/`}
                imagem={imagem}
                tags={[...tags, ROTULO_ESTATUTO[c.data.estatuto]]}
                titulo={c.data.titulo}
                resumo={c.data.resumo}
                data={dataCurta(c.data.atualizado)}
                dataISO={c.data.atualizado}
              />
            ))}
          </div>
        </section>
      </div>

      <div class="ref-column ref-middle">
        <section class="ref-section" aria-labelledby="h-video">
          <div class="ref-section-title">
            <div><h2 id="h-video">Vídeo em Destaque</h2></div>
            <a href="/videos/">Ver mais vídeos <span aria-hidden="true">→</span></a>
          </div>
          <VideoFeature id={video.id} titulo={video.titulo} canal={video.canal} resumo={VIDEO_DESTAQUE.resumo} poster={VIDEO_DESTAQUE.poster} />
        </section>
        <figure class="ref-quote">
          <span class="ref-quote-glyph" aria-hidden="true">“</span>
          <blockquote>Conhecimento<br />e disciplina constroem<br />um futuro mais inteligente.</blockquote>
          <figcaption class="ref-quote-caption">HARPYA</figcaption>
        </figure>
      </div>

      <div class="ref-column ref-right">
        <section class="ref-section" aria-labelledby="h-forum">
          <div class="ref-section-title">
            <div><h2 id="h-forum">Fórum da Comunidade</h2></div>
            <a href="/forum/">Ver fórum <span aria-hidden="true">→</span></a>
          </div>
          <ForumList topicos={TOPICOS_PROPOSTOS} />
        </section>
        <JoinCommunityCard />
      </div>
    </div>
  </section>
</Base>
