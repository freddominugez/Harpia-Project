---
import Base from "../layouts/Base.astro";
import PageIntro from "../components/PageIntro.astro";
import ResponsiveGrid from "../components/ResponsiveGrid.astro";
import Tag from "../components/Tag.astro";
import M from "../components/M.astro";
import { APRENDIZADO as ml } from "../lib/conteudo";
---
<Base titulo="Aprendizado de Máquina" descricao="As primeiras tentativas de fazer a máquina aprender, com a regra de atualização de cada uma.">
  <PageIntro trilha={[{ rotulo: "Aprendizado de Máquina" }]} eyebrow="Antes das LLMs" titulo="As primeiras tentativas de fazer a máquina aprender" lead="Quase toda ideia de hoje tem um ancestral simples. Algumas falharam por motivos que ainda valem." />
  <section class="page-body">
    <div class="container">
      <ResponsiveGrid min="300px">
        {ml.map((i: any) => (
          <article class="card">
            <Tag variante="soft-gold">{i.ano}</Tag>
            <h3>{i.titulo}</h3>
            <p>{i.texto}</p>
            {i.eq && <div class="eq"><M t={i.eq} /></div>}
          </article>
        ))}
      </ResponsiveGrid>
    </div>
  </section>
</Base>
