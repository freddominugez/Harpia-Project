---
// Card da home "Para quem está começando": a série da seção /comecando/.
import { COMECANDO, SERIE } from "../data/comecando";
interface Props { serie?: string; lead?: string; artigos?: { numero: number; titulo: string; descricao: string; slug: string; href?: string }[] }
const { serie = SERIE, lead = 'Do token ao espaço vetorial, em artigos curtos e ilustrados. Sem pré-requisito.', artigos = COMECANDO } = Astro.props;
const artigosSerie: NonNullable<Props['artigos']> = artigos;
const n2 = (n: number) => String(n).padStart(2, "0");
---
<div class="ref-start">
  <p class="ref-start-serie">{serie}</p>
  <p class="ref-start-lead">{lead}</p>
  <ol class="ref-start-list">
    {artigosSerie.map((a) => (
      <li>
        <a href={a.href ?? `/comecando/${a.slug}/`}>
          <span class="ref-start-num" aria-hidden="true">{n2(a.numero)}</span>
          <span class="ref-start-txt"><b>{a.titulo}</b><small>{a.descricao}</small></span>
        </a>
      </li>
    ))}
  </ol>
</div>
