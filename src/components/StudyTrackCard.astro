---
// Card de trilha de estudo: ícone, título, descrição e rodapé com o nível.
import type { Trilha } from "../data/home";
interface Props { t: Trilha }
const { t } = Astro.props;
---
<a class="ref-track" href={t.href}>
  <span class="ref-track-head">
    <img class="icon gold" src={`/icons/${t.icone}.svg`} alt="" aria-hidden="true" width="28" height="28" />
    <span><h3>{t.titulo}</h3><p>{t.resumo}</p></span>
  </span>
  <span class="ref-track-meta">
    <span class="level"><img class="icon" src="/icons/chart.svg" alt="" aria-hidden="true" width="13" height="13" />{t.nivel}</span>
    <span class="go" aria-hidden="true">→</span>
  </span>
</a>
