---
import { getBusiness, TRILHAS_BUSINESS, SECOES_BUSINESS, guiaPath, trilhaNome, recursosDaSecao } from '../lib/business';
import { EDITORIAL_BUSINESS } from '../data/business-editorial';
import BusinessResourceCard from './BusinessResourceCard.astro';
import Forum from './Forum.astro';
interface Props { secao: string }
const { secao } = Astro.props;
const { guias, acervo, fontes, canais } = await getBusiness();
const page = SECOES_BUSINESS.find(s => s.slug === secao)!;
const fonteNome = (id: string) => fontes.find(f => f.id === id)?.data.nome ?? id;
const blocos = EDITORIAL_BUSINESS[secao] ?? [];
const leituras = recursosDaSecao(acervo, secao);
const lista = ['biblioteca', 'biblioteca/livros', 'news', 'analises', 'noticias', 'videos'].includes(secao);
const fontesArtigos = fontes.filter(f => f.data.escopos.includes('artigos'));
const rotulo = secao === 'videos' ? 'vídeos' : secao === 'biblioteca/livros' ? 'livros' : secao === 'noticias' ? 'notícias' : secao === 'analises' ? 'análises' : 'leituras';
---
{secao === '' ? <>
  <section class="business-hero"><div class="container"><div class="business-hero-copy"><span class="eyebrow">Marketing &amp; administração</span><h1 tabindex="-1">Decisões melhores<br />começam com<br /><em>boas perguntas.</em></h1><p>Pesquisa, estratégia e gestão com base em evidências. Um espaço para compreender mercados, estudar organizações e decidir melhor.</p><div class="business-hero-actions"><a class="btn gold" href="/business/estudos/">Explorar as trilhas →</a><a class="btn outline" href="/business/biblioteca/">Abrir a biblioteca</a></div></div><img src="/img/ambientes/harpia-business.png" width="600" height="400" alt="Harpia com asas abertas em formas geométricas de grafite e dourado." class="business-hero-art" /></div></section>
  <div class="container business-kpis"><div><strong>{guias.length}</strong><span>guias de estudo</span></div><div><strong>{acervo.filter(a => a.data.tipo !== 'video').length}</strong><span>leituras selecionadas</span></div><div><strong>{fontesArtigos.length}</strong><span>fontes de referência</span></div><div><strong>3</strong><span>mercados: Brasil, EUA e Europa</span></div></div>
  <section class="container business-section"><div class="business-section-heading"><div><span class="eyebrow">Do fundamento à aplicação</span><h2>Escolha sua próxima pergunta</h2></div><a href="/business/estudos/">Todas as trilhas →</a></div><div class="business-trails">{guias.slice(0,4).map(g => <a class="business-trail" href={guiaPath(g.id)}><span>{String(g.data.numero).padStart(2,'0')} / TRILHA</span><h3>{g.data.titulo}</h3><p>{g.data.resumo}</p><b aria-hidden="true">↗</b></a>)}</div></section>
  <section class="container business-section"><div class="business-section-heading"><div><span class="eyebrow">Com procedência e contexto</span><h2>Leituras para aprofundar</h2></div><a href="/business/biblioteca/">Abrir a biblioteca →</a></div><div class="business-resource-grid">{acervo.slice(0,3).map(item => <BusinessResourceCard item={item} fonte={fonteNome(item.data.fonte)} />)}</div></section>
  <section class="container business-section business-home-bottom"><div class="business-feature"><span class="eyebrow">Para quem está começando</span><h2>Da ideia de valor à leitura de resultados.</h2><p>Oito guias em sequência para construir uma base de marketing e administração, com exercícios e limites claros.</p><a class="business-read" href="/business/comecando/">Começar pelo primeiro guia →</a></div><div class="business-feature"><span class="eyebrow">Comunidade</span><h2>Estude. Pergunte. Conteste.</h2><p>Discuta problemas de marketing com referências. Diferencie uma hipótese, um caso e uma evidência medida.</p><a class="business-read" href="/business/forum/">Abrir a conversa →</a></div></section>
</> : <>
  <section class="container business-page-intro"><nav aria-label="Caminho da página"><a href="/business/">Harpya Business</a><span aria-hidden="true"> / </span><span>{page.nav}</span></nav><span class="eyebrow">{['videos','biblioteca','news','noticias'].includes(secao) ? 'Curadoria de conhecimento' : 'Marketing & administração'}</span><h1 tabindex="-1">{page.titulo}</h1><p>{page.descricao}</p></section>
  <div class="container business-section">
    {['estudos','comecando'].includes(secao) && <><p class="business-note">{secao === 'comecando' ? 'Siga a sequência ou escolha o assunto mais próximo da sua pergunta. Cada guia identifica suas referências.' : 'Cada trilha combina um guia didático, perguntas para estudo e fontes para aprofundamento.'}</p><div class="business-trails">{guias.map(g => <a class="business-trail" href={guiaPath(g.id)}><span>{String(g.data.numero).padStart(2,'0')} / {trilhaNome(g.data.trilha)}</span><h2>{g.data.titulo}</h2><p>{g.data.resumo}</p><b aria-hidden="true">↗</b></a>)}</div></>}
    {blocos.length > 0 && <div class="business-editorial">{blocos.map((bloco,index) => <section id={`secao-${index+1}`}><h2>{bloco.titulo}</h2><p>{bloco.texto}</p>{bloco.formula && <div class="business-formula">{bloco.formula}</div>}{bloco.itens && <ul>{bloco.itens.map(item => <li>{item}</li>)}</ul>}</section>)}<p class="business-note">Texto didático autoral do Harpya. Para aprofundar e avaliar a evidência, consulte a <a href="/business/biblioteca/">biblioteca</a> e as <a href="/business/biblioteca/fontes/">fontes de referência</a>.</p></div>}
    {secao === 'biblioteca/fontes' && <><div class="business-source-grid">{fontesArtigos.map(f => <article class="business-source"><span>{f.data.regiao} · {f.data.idioma.toUpperCase()}</span><h2><a href={f.data.url} target="_blank" rel="noopener noreferrer">{f.data.nome} ↗</a></h2><p>{f.data.descricao}</p><small>{f.data.tipo.replaceAll('-',' ')} · referência institucional</small>{f.data.restricao && <p class="business-note">{f.data.restricao}</p>}</article>)}</div><div class="business-policy"><h2>O nome da instituição não substitui a revisão.</h2><p>Separamos pesquisa acadêmica, análise executiva, relatório de consultoria e jornalismo. Antes de publicar, verificamos autoria, evidência, limites e conflitos de interesse. Coaches, agências de marketing digital e promessas sem fundamentação não entram no acervo.</p><a href="/business/sobre/">Conhecer o método editorial →</a></div></>}
    {lista && <>
      <form class="business-filters" role="search" data-business-filter data-label={rotulo}>
        <label>Pesquisar {rotulo}<input type="search" name="query" placeholder="Título, tema, autor ou fonte" /></label>
        <label>Trilha<select name="trail"><option value="">Todas as trilhas</option>{TRILHAS_BUSINESS.map(t => <option value={t.id}>{t.titulo}</option>)}</select></label>
        {secao === 'biblioteca' && <label>Formato<select name="kind"><option value="">Todos os formatos</option><option value="artigo">Artigos</option><option value="livro">Livros</option><option value="relatorio">Relatórios</option><option value="webinar">Webinars</option></select></label>}
        <label>Idioma<select name="language"><option value="">Todos os idiomas</option><option value="pt">Português</option><option value="en">Inglês</option><option value="es">Espanhol</option></select></label>
        {secao === 'videos' && <><label>Nível<select name="level"><option value="">Todos os níveis</option>{['Iniciante','Intermediário','Avançado'].map(n => <option>{n}</option>)}</select></label><label>Instituição<select name="source"><option value="">Todas as instituições</option>{fontes.filter(f => f.data.canais.some(c => c.status === 'aprovado')).map(f => <option value={f.id}>{f.data.nome}</option>)}</select></label></>}
      </form>
      {leituras.length ? <><p data-business-count aria-live="polite" class="business-note">{leituras.length} resultados no acervo. Acesso e idioma informados em cada ficha.</p><div class="business-resource-grid">{leituras.map(item => <BusinessResourceCard item={item} fonte={fonteNome(item.data.fonte)} />)}</div><p data-business-empty class="business-note" hidden>Nenhum resultado corresponde aos filtros. Tente outra combinação.</p></> : <div class="business-empty"><span class="eyebrow">Seleção em preparação</span><h2>{secao === 'videos' ? 'Aulas com fundamento, do início ao fim.' : secao === 'biblioteca/livros' ? 'Literatura com autoria e procedência.' : secao === 'analises' ? 'Análises com perguntas, método e limites.' : secao === 'noticias' ? 'Notícias com origem e contexto.' : 'Novas leituras em revisão.'}</h2><p>A seleção de {rotulo} aguarda aprovação editorial. Os candidatos não integram o acervo público.</p><a class="btn gold" href="/business/comecando/">Explorar os guias de estudo →</a></div>}
    </>}
    {secao === 'biblioteca' && <p class="business-note business-collection-links"><a href="/business/biblioteca/livros/">Literatura de referência →</a> · <a href="/business/biblioteca/fontes/">Fontes dos artigos →</a></p>}
    {secao === 'biblioteca/livros' && <div class="business-policy"><h2>Uma ficha para orientar o estudo</h2><p>Cada obra identifica autoria, editora, edição quando confirmada e acesso legal. A seleção bibliográfica não implica validação de todas as afirmações do livro. Não distribuímos cópias integrais nem substituímos a leitura da obra.</p></div>}
    {secao === 'news' && <div class="business-policy"><h2>Acompanhe as editorias de referência</h2><p>O radar apresenta leituras publicadas pela curadoria. A coleta automática envia novos títulos para revisão; candidatos não são publicados como notícia.</p><div class="business-source-links">{fontesArtigos.map(f => <a href={f.data.url} target="_blank" rel="noopener noreferrer">{f.data.nome} ↗</a>)}</div></div>}
    {secao === 'videos' && <div class="business-policy"><h2>Como um vídeo entra no acervo</h2><ol><li>Confirmamos o canal no site institucional, sem usar popularidade como critério de qualidade.</li><li>Verificamos a formação, o vínculo e as referências de quem apresenta.</li><li>Revisamos o material integral, o contexto e as limitações das afirmações.</li><li>Registramos o motivo da seleção, o canal, a data e o responsável pela revisão.</li></ol><p>Podcasts passam pela mesma régua. Coaches, agências de marketing digital, cortes sem contexto e promessas de resultado garantido são excluídos.</p><a href="/business/videos/canais/">Consultar os canais aprovados →</a></div>}
    {secao === 'videos/canais' && <>{canais.length ? <div class="business-source-grid">{canais.map(c => <article class="business-source"><span>Canal institucional · conferido em {c.verificado_em}</span><h2><a href={c.url} target="_blank" rel="noopener noreferrer">{c.nome} ↗</a></h2><p>{c.instituicao}</p><a class="business-read" href={c.procedencia} target="_blank" rel="noopener noreferrer">Ver referência institucional ↗</a><small class="business-channel-id">{c.id}</small></article>)}</div> : <div class="business-empty"><h2>Canais em aprovação</h2><p>Os canais propostos aguardam aprovação do catálogo. Mesmo após a aprovação de um canal, cada vídeo precisa de revisão individual antes de aparecer no acervo.</p></div>}<p class="business-note business-collection-links"><a href="/business/videos/">← Voltar aos vídeos</a></p></>}
    {secao === 'forum' && <><div class="business-policy"><h2>Uma conversa própria de Business</h2><p>Use referências, descreva o contexto e explicite o que é hipótese. As conversas desta página são identificadas pelo endereço /business/forum/, separadas das conversas de Tecnologia e Matemática.</p><ul><li>Como escolher entre pesquisa declarada e comportamento observado?</li><li>Quando um caso empresarial pode informar uma decisão de marca?</li><li>Como separar retorno atribuído e efeito incremental?</li></ul><small>Os temas acima são propostas de conversa, não discussões já existentes.</small></div><Forum geral path="/business/forum/" /></>}
  </div>
</>}
<script>
  const form = document.querySelector<HTMLFormElement>('[data-business-filter]');
  if (form) {
    const normalize = (text: string) => text.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();
    const apply = () => {
      const values = new FormData(form), query = normalize(String(values.get('query') || '')).trim().split(/\s+/).filter(Boolean);
      let count = 0;
      document.querySelectorAll<HTMLElement>('[data-business-resource]').forEach(card => {
        const match = (!values.get('trail') || card.dataset.trail === values.get('trail')) && (!values.get('kind') || card.dataset.kind === values.get('kind')) && ['level','language','source'].every(key => !values.get(key) || card.dataset[key] === values.get(key)) && query.every(term => normalize(card.dataset.text || '').includes(term));
        card.hidden = !match; if(match) count++;
      });
      const label = document.querySelector('[data-business-count]'), empty = document.querySelector<HTMLElement>('[data-business-empty]');
      if(label) label.textContent = `${count} resultado${count === 1 ? '' : 's'} em ${form.dataset.label || 'leituras'}.`;
      if(empty) empty.hidden = count > 0;
    };
    const trail = new URLSearchParams(location.search).get('trilha');
    if (trail) { const select = form.querySelector<HTMLSelectElement>('[name=trail]'); if(select && [...select.options].some(option => option.value === trail)) { select.value = trail; apply(); } }
    form.addEventListener('input',apply);form.addEventListener('change',apply);form.addEventListener('submit',event=>{event.preventDefault();apply();});
  }
</script>
