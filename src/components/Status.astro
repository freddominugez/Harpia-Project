---
// Selo de estatuto: medido, arte (arte prévia), lacuna, teste.
import Tag from "./Tag.astro";
interface Props { tipo: "medido" | "arte" | "lacuna" | "teste"; texto?: string }
const { tipo, texto } = Astro.props;
const padrao = { medido: "medido no projeto", arte: "arte prévia", lacuna: "lacuna", teste: "teste ou enquadramento" };
---
<Tag variante={tipo}>{texto ?? padrao[tipo]}</Tag>
