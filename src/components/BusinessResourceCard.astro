---
import { recursoPath, trilhaNome, type BusinessResource } from '../lib/business';
interface Props { item: BusinessResource; fonte?: string }
const { item, fonte = item.data.fonte } = Astro.props;
const d = item.data;
---
<article class="business-resource" data-business-resource data-kind={d.tipo} data-trail={d.trilha} data-source={d.fonte} data-level={d.nivel} data-language={d.idioma} data-text={`${d.titulo} ${d.resumo} ${d.autores} ${fonte} ${d.editora}`}>
  <div class="business-card-meta"><span>{({relatorio:'Relatório',video:'Vídeo',livro:'Livro',noticia:'Notícia',analise:'Análise',webinar:'Webinar',artigo:'Artigo'})[d.tipo]}</span><span>{d.idioma.toUpperCase()}</span></div>
  <h3><a href={recursoPath(item.id)}>{d.titulo}</a></h3><p>{d.resumo}</p><small>{d.tipo === 'livro' ? `${d.autores} · ${d.editora}` : fonte} · {trilhaNome(d.trilha)}{d.tipo === 'video' && ` · ${d.nivel}`}</small><a class="business-read" href={recursoPath(item.id)}>Ver ficha e referência →</a>
</article>
