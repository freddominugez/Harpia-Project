---
// Card de artigo com imagem, chips, data, título, resumo, próximo teste, regra de parada, arte prévia e "Ler mais".
interface Props { href: string; imagem: string; tags: string[]; titulo: string; resumo: string; data?: string; dataISO?: string; proximo?: string; parar?: string; arte?: string[] }
const { href, imagem, tags, titulo, resumo, data, dataISO, proximo, parar, arte } = Astro.props;
---
<a class="ref-article" href={href}>
  <img class="ref-article-image" src={imagem} alt="" loading="lazy" decoding="async" width="900" height="262" />
  <div class="ref-article-content">
    <div class="ref-article-tags">{tags.map((t) => <span>{t}</span>)}{data && <time datetime={dataISO}>{data}</time>}</div>
    <h3>{titulo}</h3>
    <p>{resumo}</p>
    {proximo && <p class="ref-article-next"><b>Próximo teste:</b> {proximo}</p>}
    {parar && <p class="ref-article-next extra"><b>Parar se:</b> {parar}</p>}
    {arte && arte.length > 0 && <p class="ref-article-next extra"><b>Arte prévia:</b> {arte.join("; ")}</p>}
    <span class="ref-article-more">Ler mais <span aria-hidden="true">→</span></span>
  </div>
</a>
