---
// Card "Vídeos em Destaque" da home: vídeos empilhados, um acima do outro,
// cada um com miniatura real, nível, título, resumo e canal.
import VideoList from "./VideoList.astro";
import type { Video } from "../lib/videos";
interface Props { videos: Video[] }
const { videos } = Astro.props;
---
<div class="ref-feature-video">
  <span class="ref-video-label"><span class="ref-vid-tag">Seleção da semana</span><span>um vídeo por nível</span></span>
  <VideoList videos={videos} />
</div>
