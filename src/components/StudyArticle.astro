---
// Ficha de cada caminho, no padrão editorial de docs/referencia-visual-aprovada.png:
// trilha, H1, descrição, etiquetas, equação central, blocos numerados, índice lateral fixo,
// trilhas relacionadas e discussão.
import PageIntro from "./PageIntro.astro";
import ArticleSidebar from "./ArticleSidebar.astro";
import M from "./M.astro";
import Status from "./Status.astro";
import Tag from "./Tag.astro";
import Forum from "./Forum.astro";
import { SITE, giscusConfigurado, forumProprio } from "../config";
const forumAtivo = forumProprio() || giscusConfigurado();
import { dataNumerica, ROTULO_ESTATUTO } from "../lib/format";
import type { Relacionado, TocItem } from "../lib/types";

import type { render } from 'astro:content';
type Estatuto = keyof typeof ROTULO_ESTATUTO;
type Study = { id: string; body?: string; href?: string; markdown?: string; data: {
  numero: number; titulo: string; resumo: string; atualizado: string; estatuto: Estatuto;
  selo?: string; principal?: boolean; equacao?: string; mecanismo?:string; proximo_teste?: string; parar_se?: string;
  arte_previa: (string|{texto:string;url:string})[]; rotulo?: string; autor?: string; referencias_descricao?: string;
} };
interface Props { c: Study; todos: Study[]; ant: Study | null; prox: Study | null; Content: Awaited<ReturnType<typeof render>>['Content']; headings: { depth: number; slug: string; text: string }[]; prefixo?: string }
const { c, todos, ant, prox, Content, headings, prefixo = '' } = Astro.props;
const d = c.data;
const urlCaminho = (x: { id: string; href?: string }) => x.href ?? `${prefixo}/estudos/caminhos/${x.id}/`;
const rotulo = d.rotulo ?? 'Caminho';
const autor = d.autor ?? SITE.autor;
const num = String(d.numero).padStart(2, "0");
const palavras = (c.body ?? "").split(/\s+/).filter(Boolean).length + d.resumo.split(/\s+/).length + 60;
const minutos = Math.max(1, Math.round(palavras / 200));

const toc: TocItem[] = [
  ...headings.filter((h) => h.depth === 2).map((h) => ({ id: h.slug, texto: h.text })),
  ...(d.proximo_teste || d.parar_se ? [{ id: "teste", texto: "Teste e regra de parada" }] : []),
  ...(d.arte_previa.length ? [{ id: "arte-previa", texto: "Arte prévia" }] : []),
  { id: "discussao", texto: "Discussão" },
];

const icone = { medido: "chart", arte: "book", lacuna: "network", teste: "sigma" } as const;
const vizinhos = [ant, prox].filter((x): x is NonNullable<typeof x> => !!x);
const mesmos = todos.filter((x) => x.id !== c.id && x.data.estatuto === d.estatuto && !vizinhos.some((v) => v.id === x.id)).slice(0, 2);
const relacionados: Relacionado[] = [...vizinhos, ...mesmos].map((x) => ({
  href: urlCaminho(x),
  titulo: x.data.titulo,
  sub: `${rotulo} ${String(x.data.numero).padStart(2, "0")} · ${ROTULO_ESTATUTO[x.data.estatuto]}`,
  icone: icone[x.data.estatuto],
}));
---

  <PageIntro
    trilha={[{ rotulo: "Estudos", href: `${prefixo}/estudos/` }, { rotulo: `${rotulo} ${num}`, href: `${prefixo}/estudos/#caminhos` }, { rotulo: d.titulo }]}
    eyebrow={`${rotulo} ${num}${d.principal ? " · linha principal" : ""}`}
    titulo={d.titulo}
    lead={d.resumo}
  >
    <div class="tag-row">
      <Tag variante="gold">{`${rotulo} ${num}`}</Tag>
      <Status tipo={d.estatuto} texto={d.selo} />
      {d.principal && <Tag variante="soft-gold">Linha principal</Tag>}
    </div>
    <div class="page-meta">
      <span class="author">
        <img src="/img/harpya-mark-head.webp" alt="" width="38" height="38" />
        <span><b>{autor}</b>{SITE.nome}</span>
      </span>
      <span><img class="icon" src="/icons/file.svg" alt="" aria-hidden="true" width="16" height="16" />Atualizado em <time datetime={d.atualizado}>{dataNumerica(d.atualizado)}</time></span>
      <span><img class="icon" src="/icons/book.svg" alt="" aria-hidden="true" width="16" height="16" />{minutos} min de leitura</span>
      <span><img class="icon" src="/icons/messages.svg" alt="" aria-hidden="true" width="16" height="16" />{forumAtivo ? "Discussão aberta" : "Fórum aguardando ativação"}</span>
    </div>
  </PageIntro>

  <div class="container page-layout">
    <article class="article">
      {(d.equacao || d.mecanismo) && (
        <div class="article-banner">
          <div>
            <span class="kicker">{d.equacao ? "Equação central do mecanismo" : "Mecanismo a investigar"}</span>
            {d.equacao ? <M t={d.equacao} d /> : <p>{d.mecanismo}</p>}
          </div>
          <img src="/img/harpya-mark-head.webp" alt="" width="150" height="140" loading="lazy" />
        </div>
      )}
      <div class="prose numbered">
        <Content />
        {(d.proximo_teste || d.parar_se) && <><h2 id="teste">Teste e regra de parada</h2>
        {d.proximo_teste && <p><b>Próximo teste.</b> {d.proximo_teste}</p>}
        {d.parar_se && <div class="notice"><p><b>Parar se.</b> {d.parar_se}</p></div>}</>}
        {d.arte_previa.length > 0 && (
          <>
            <h2 id="arte-previa">Arte prévia</h2>
            <p>{d.referencias_descricao ?? 'O que já existe publicado sobre este mecanismo. A ficha diz o que pode ser novo.'}</p>
            <ul>{d.arte_previa.map((a) => <li>{typeof a === "string" ? a : <a href={a.url} target="_blank" rel="noopener noreferrer">{a.texto}</a>}</li>)}</ul>
          </>
        )}
        <p class="cite"><b>Como citar.</b> {autor} ({d.atualizado.slice(0, 4)}). <i>{d.titulo}</i>. {SITE.nome}. <a href={`https://www.harpya.org${urlCaminho(c)}`}>https://www.harpya.org{urlCaminho(c)}</a>. Texto em markdown: <a href={c.markdown ?? `${prefixo}/estudos/caminhos/${c.id}.md`}>{c.id}.md</a>. Licença CC BY 4.0.</p>
        <h2 id="discussao">Discussão</h2>
      </div>
      <Forum path={prefixo ? urlCaminho(c) : undefined} />
      <nav class="next-prev" aria-label="Caminhos vizinhos">
        {ant && <a href={urlCaminho(ant)}><small>← Anterior</small>{ant.data.titulo}</a>}
        {prox && <a class="next" href={urlCaminho(prox)}><small>Próximo →</small>{prox.data.titulo}</a>}
      </nav>
    </article>
    <ArticleSidebar toc={toc} relacionados={relacionados}>
      <div class="surface aside-panel">
        <h3>Discussão no fórum</h3>
        {forumProprio() ? (
          <p>Cada caminho tem a sua própria conversa. Entre com e-mail e senha ou com a conta Google.</p>
        ) : giscusConfigurado() ? (
          <p>Cada caminho tem a sua própria conversa, com login pelo GitHub.</p>
        ) : (
          <p>O fórum (GitHub Discussions via Giscus) ainda não foi ativado. Enquanto isso, nenhuma discussão é exibida.</p>
        )}
        <a class="card-link" href="#discussao">Ir para a discussão →</a>
      </div>
    </ArticleSidebar>
  </div>
