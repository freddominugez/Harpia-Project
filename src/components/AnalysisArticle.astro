---
import PageIntro from './PageIntro.astro';
import ArticleSidebar from './ArticleSidebar.astro';
import {SITE} from '../config';
import {dataNumerica} from '../lib/format';
import type {TocItem,Relacionado} from '../lib/types';
interface Props {d:{serie:string;parte:number;total:number;titulo_curto:string;resumo:string;data:string};minutos:number;toc:TocItem[];relacionados:Relacionado[];autor?:string;prefixo?:string}
const {d,minutos,toc,relacionados,autor=SITE.autor,prefixo=''}=Astro.props;
---
<PageIntro
    trilha={[{ rotulo: "Análises", href: `${prefixo}/analises/` }, { rotulo: `${d.serie}, parte ${d.parte}` }]}
    eyebrow={`${d.serie} · parte ${d.parte} de ${d.total}`}
    titulo={d.titulo_curto}
    lead={d.resumo}
  />
  <div class="container page-layout">
    <article class="article prose analise">
      <p class="analise-meta"><b>{autor}</b> · <time datetime={d.data}>{dataNumerica(d.data)}</time> · {minutos} min de leitura</p>
      <slot />
    </article>
    <ArticleSidebar toc={toc} relacionados={relacionados} tituloRelacionados="Nesta série" />
  </div>
