---
interface Props { id:string; numero:number; titulo:string; descricao:string; etapas:string[]; legenda:string; tipo?:'cartoes'|'radial'|'experimento'; central?:string }
const {id,numero,titulo,descricao,etapas,legenda,tipo='cartoes',central=''}=Astro.props;
const colunas=Math.min(3,etapas.length),linhas=Math.ceil(etapas.length/colunas);
const largura=660/colunas;
const quebrar=(texto:string,max=26)=>{const linhas:string[]=[];let atual='';for(const p of texto.split(/\s+/)){if(atual.length+p.length>max){linhas.push(atual);atual=p;}else atual+=(atual?' ':'')+p;}if(atual)linhas.push(atual);return linhas;};
const pontos=[[120,105],[600,105],[120,295],[600,295],[360,420]];
const cartoes=etapas.map((texto,i)=>({texto,i,x:30+(i%colunas)*largura,y:50+Math.floor(i/colunas)*145}));
const altura=tipo==='radial'?510:tipo==='experimento'?530:70+linhas*145;
---
<figure>
  <svg viewBox={`0 0 720 ${altura}`} role="img" aria-label={descricao}>
    <defs><marker id={`seta-${id}`} markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8 z" fill="var(--muted)" /></marker></defs>
    <text x="18" y="24" class="lbl">Figura {numero}. {titulo}</text>
    {tipo==='radial'&& <>
      {etapas.map((_,i)=><line x1="360" y1="235" x2={pontos[i][0]} y2={pontos[i][1]} stroke="var(--muted)" stroke-width="1.3" />)}
      <rect x="260" y="180" width="200" height="110" rx="12" class="box" /><text x="360" y="213" text-anchor="middle" font-size="15">{quebrar(central).map((s,i)=><tspan x="360" dy={i?19:0}>{s}</tspan>)}</text>
      {etapas.map((s,i)=><g><rect x={pontos[i][0]-100} y={pontos[i][1]-58} width="200" height="116" rx="8" class="box" /><text x={pontos[i][0]} y={pontos[i][1]-25} text-anchor="middle" font-size="14">{quebrar(s).map((t,j)=><tspan x={pontos[i][0]} dy={j?18:0}>{t}</tspan>)}</text></g>)}
    </>}
    {tipo==='experimento'&& <>
      <rect x="180" y="48" width="360" height="65" rx="8" class="box" /><text x="360" y="77" text-anchor="middle" font-size="14">{etapas[0]}</text>
      <line x1="360" y1="115" x2="360" y2="145" class="arrow" marker-end={`url(#seta-${id})`} />
      <rect x="140" y="150" width="440" height="70" rx="8" class="box" /><text x="360" y="176" text-anchor="middle" font-size="14">{quebrar(etapas[1],50).map((t,j)=><tspan x="360" dy={j?18:0}>{t}</tspan>)}</text>
      {[190,530].map(x=><path d={`M360 220 L${x} 255`} class="arrow" marker-end={`url(#seta-${id})`} />)}
      {etapas.slice(2,4).map((t,i)=><g><rect x={40+i*340} y="260" width="300" height="105" rx="8" class="box" /><text x={190+i*340} y="286" text-anchor="middle" font-size="14">{quebrar(t,35).map((s,j)=><tspan x={190+i*340} dy={j?18:0}>{s}</tspan>)}</text></g>)}
      {[190,530].map(x=><path d={`M${x} 365 L360 400`} class="arrow" marker-end={`url(#seta-${id})`} />)}
      <rect x="115" y="407" width="490" height="90" rx="8" class="box" /><text x="360" y="435" text-anchor="middle" font-size="14">{quebrar(etapas[4],52).map((t,j)=><tspan x="360" dy={j?19:0}>{t}</tspan>)}</text>
    </>}
    {tipo==='cartoes'&&cartoes.map(c=><g><rect x={c.x} y={c.y} width={largura-16} height="130" rx="8" class="box"/><text x={c.x+12} y={c.y+20} class="lbl">{String(c.i+1).padStart(2,'0')}</text><text x={c.x+(largura-16)/2} y={c.y+45} text-anchor="middle" font-size="14">{quebrar(c.texto).map((t,j)=><tspan x={c.x+(largura-16)/2} dy={j?17:0}>{t}</tspan>)}</text></g>)}
  </svg>
  <figcaption>{legenda}</figcaption>
</figure>
