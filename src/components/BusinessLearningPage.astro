---
import {getBusiness} from '../lib/business';
import LearningPage from './LearningPage.astro';
const {aprendizado}=await getBusiness();
const ideias=aprendizado.map(x=>({...x.data,ano:x.data.numero}));
---
<LearningPage ideias={ideias} rotulo="Aprendizado em marketing" eyebrow="Da pergunta à decisão" titulo="Como aprender com mercados, clientes e resultados" lead={`${ideias.length} etapas com contexto, mecanismos, exemplos hipotéticos, limites e referências. Os números identificam a sequência de estudo; não são anos históricos.`} introducao={['O percurso liga duas perguntas: como criar valor para um público e como saber se uma decisão melhorou o resultado. A resposta exige definir a situação, escolher medidas e examinar explicações concorrentes.', 'Os números dos exemplos são hipotéticos e servem para refazer as contas. Eles não descrevem clientes, vendas ou experimentos realizados pelo Harpya. Cada fonte informa o alcance do material consultado.']} notacao={[{tex:'n',texto:'é o tamanho de um grupo; defina quais pessoas ou eventos foram contados.'},{tex:'p',texto:'representa uma proporção definida para uma população e período.'},{tex:'R,C,M',texto:'representam receita, custos e contribuição sob as definições de cada exemplo.'}]} relacionados={[{href:'/business/equacoes/',titulo:'Métricas e métodos',sub:'Definições e pressupostos',icone:'sigma'},{href:'/business/origens/',titulo:'Origens',sub:'Marcos e contextos documentados',icone:'globe'},{href:'/business/biblioteca/',titulo:'Biblioteca',sub:'Fontes para aprofundamento',icone:'book'}]} marcador="Etapa" coluna="Na decisão de marketing" fio="As etapas formam um ciclo: delimitar a decisão, observar o contexto, formular uma hipótese, comparar alternativas e revisar a conclusão. O método escolhido depende da pergunta e das condições de aplicação." />
