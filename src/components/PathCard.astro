---
import M from "./M.astro";
import Status from "./Status.astro";
const { c } = Astro.props;
const d = c.data;
---
<a class="card path" href={`/estudos/caminhos/${c.id}/`}>
  <span class="n">{String(d.numero).padStart(2, "0")}{d.principal ? " · linha principal" : ""}</span>
  <h3>{d.titulo}</h3>
  <Status tipo={d.estatuto} texto={d.selo} />
  {d.equacao && <div class="eq"><M t={d.equacao} /></div>}
  <p>{d.resumo}</p>
</a>
