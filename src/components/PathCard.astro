---
// Card de caminho válido: número, título, selo de estatuto, resumo e equação.
import M from "./M.astro";
import Status from "./Status.astro";
const { c } = Astro.props;
const d = c.data;
---
<a class="card path" href={c.href ?? `/estudos/caminhos/${c.id}/`}>
  <span class="n">{`${d.rotulo ?? "Caminho"} ${String(d.numero).padStart(2, "0")}`}{d.principal ? " · linha principal" : ""}</span>
  <h3>{d.titulo}</h3>
  <Status tipo={d.estatuto} texto={d.selo} />
  <p>{d.resumo}</p>
  {(d.equacao || d.mecanismo) && <div class="eq">{d.equacao ? <M t={d.equacao} /> : <span>{d.mecanismo}</span>}</div>}
</a>
