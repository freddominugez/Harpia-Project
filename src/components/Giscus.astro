---
// Fórum por página via Giscus (GitHub Discussions).
import { GISCUS, giscusConfigurado } from "../config";
interface Props { geral?: boolean }
const { geral = false } = Astro.props;
const categoria = geral ? GISCUS.categoriaGeral : GISCUS.categoria;
const categoriaId = geral ? GISCUS.categoriaGeralId || GISCUS.categoriaId : GISCUS.categoriaId;
const ok = giscusConfigurado();
---
<div class="giscus-wrap">
  {ok ? (
    <>
      <div class="giscus"></div>
      <script is:inline src="https://giscus.app/client.js"
        data-repo={GISCUS.repo}
        data-repo-id={GISCUS.repoId}
        data-category={categoria}
        data-category-id={categoriaId}
        data-mapping="pathname"
        data-strict="1"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="top"
        data-theme="light"
        data-lang="pt"
        data-loading="lazy"
        crossorigin="anonymous"
        async></script>
    </>
  ) : (
    <div class="setup">
      <strong>O fórum ainda não foi ativado.</strong>
      <p style="margin:6px 0 0">As discussões vão acontecer no GitHub Discussions, com login pelo GitHub. Enquanto isso, nenhuma conversa é exibida aqui. As pautas propostas estão na página do <a href="/forum/">fórum</a>.</p>
      {/* Para ativar: docs/DEPLOY.md, seção "Fórum com Giscus". */}
    </div>
  )}
</div>
