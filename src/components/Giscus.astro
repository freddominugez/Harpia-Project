---
// Fórum por página via Giscus (GitHub Discussions).
import { GISCUS, giscusConfigurado } from "../config";
interface Props { geral?: boolean }
const { geral = false } = Astro.props;
const categoria = geral ? GISCUS.categoriaGeral : GISCUS.categoria;
const categoriaId = geral ? GISCUS.categoriaGeralId || GISCUS.categoriaId : GISCUS.categoriaId;
const ok = giscusConfigurado();
---
<div class="giscus-wrap">
  {ok ? (
    <>
      <div class="giscus"></div>
      <script is:inline src="https://giscus.app/client.js"
        data-repo={GISCUS.repo}
        data-repo-id={GISCUS.repoId}
        data-category={categoria}
        data-category-id={categoriaId}
        data-mapping="pathname"
        data-strict="1"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="top"
        data-theme="preferred_color_scheme"
        data-lang="pt"
        data-loading="lazy"
        crossorigin="anonymous"
        async></script>
    </>
  ) : (
    <div class="setup">
      <strong>O fórum ainda não foi ligado.</strong>
      <p style="margin-top:6px">As discussões ficam no GitHub Discussions do repositório, via Giscus. Para ativar:</p>
      <ol>
        <li>Deixe o repositório público e ative <em>Discussions</em> em Settings.</li>
        <li>Crie as categorias <em>Caminhos</em>, <em>Perguntas</em>, <em>Resultados e reproduções</em> e <em>Propostas novas</em>.</li>
        <li>Instale o app em <a href="https://github.com/apps/giscus" rel="noopener">github.com/apps/giscus</a>.</li>
        <li>Gere os IDs em <a href="https://giscus.app/pt" rel="noopener">giscus.app</a> e preencha <code>GISCUS</code> em <code>src/config.ts</code>.</li>
      </ol>
    </div>
  )}
</div>
